---
# LinApple Peripherals Configuration
# Peripherals implement standardized C ABI dispatch tables and callback signatures
# (e.g. init(slot, host), command, query) where specific hardware implementations
# intentionally leave slot/host parameters unused or cannot change parameter types
# without violating Peripheral function pointer signatures.

InheritParentConfig: true

Checks:
  - '-misc-unused-parameters'
  - '-readability-non-const-parameter'
  - '-misc-const-correctness'
